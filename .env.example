# Public Supabase project settings. The publishable key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical public URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Test-only values. Store real credentials in .env.test.local or CI secrets.
E2E_BASE_URL=http://localhost:3000
E2E_USER_EMAIL=e2e-user@example.com
E2E_USER_PASSWORD=replace-with-a-secure-password
